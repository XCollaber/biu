---
import "../index.css";
import "../App.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bareilly International University (BIU) - NAAC A+ Premier University",
  description = "Bareilly International University (BIU) - Premier NAAC A+ Accredited Private University in Uttar Pradesh offering Medical, Dental, Engineering, Pharmacy, Nursing, Law & Management degrees.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO & Search Engine Meta Tags -->
    <meta name="description" content={description} />

    <!-- Open Graph / WhatsApp / Facebook Meta Tags -->
    <!-- Production domain: https://biu.edu.in -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://biu-edu.vercel.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://biu-edu.vercel.app/og-image.jpg" />
    <meta
      property="og:image:secure_url"
      content="https://biu-edu.vercel.app/og-image.jpg"
    />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bareilly International University Campus"
    />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://biu-edu.vercel.app" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://biu-edu.vercel.app/og-image.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
