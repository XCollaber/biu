{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "BIU-cms",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-11",
  "assets": {
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },

  "r2_buckets": [
    {
      "binding": "TESTIMONIALS",
      "bucket_name": "amritaara-video",
      "remote": true
    }
  ],

  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ]
}